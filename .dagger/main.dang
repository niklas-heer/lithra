"""
Reproducible Linux checks for Lithra.
"""
type LithraCi {
  pub source: Directory! @defaultPath("/") @ignorePatterns([
    "*",
    "!Cargo.toml",
    "!Cargo.lock",
    "!rust-toolchain.toml",
    "!clippy.toml",
    "!.config",
    "!mise.toml",
    "!src",
    "!tests",
    "!benches",
  ])

  """
  Run native checks, build the release binary, and smoke-test it.
  """
  pub ci: String! {
    container
      .from("ghcr.io/jdx/mise:2026.9.5")
      .withoutFile("/mise/config.toml")
      .withWorkdir("/src")
      .withEnvVariable("MISE_TRUSTED_CONFIG_PATHS", "/src")
      # Local development helpers are not needed for checks.
      .withEnvVariable("MISE_DISABLE_TOOLS", "cargo:bacon,watchexec,github:cargo-generate/cargo-generate,github:tareqimbasher/cargo-seek,git-cliff")
      .withEnvVariable("NEXTEST_PROFILE", "ci")
      .withFile("mise.toml", source.file("mise.toml"))
      .withFile("rust-toolchain.toml", source.file("rust-toolchain.toml"))
      .withExec(["mise", "install"])
      .withDirectory("/src", source)
      .withMountedCache("/src/target", cacheVolume("lithra-rust-1-97-1-target"), sharing: CacheSharingMode.LOCKED)
      .withExec(["mise", "run", "check"])
      .withExec(["mise", "run", "build"])
      .withExec(["./target/release/lithra", "--version"])
      .stdout
  }
}
